# Salin ke .env lalu isi sendiri. Jangan commit .env.
# Dipakai docker compose dan (lewat export) aplikasi lokal.
DB_PASSWORD=
# DB_PORT=5432   # port host Postgres; ganti jika bentrok (lalu sesuaikan DATABASE_URL)

# Wajib untuk prod/compose (min 32 karakter acak, mis. `openssl rand -base64 48`)
JWT_SECRET=
# Admin awal (dibuat sekali jika belum ada admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Origin frontend, dipisah koma (mis. http://localhost:5173)
APP_CORS_ALLOWED_ORIGINS=

# Pembayaran: midtrans (default) atau fake (tanpa Midtrans; dilarang di prod)
# URL publik frontend: tujuan redirect setelah bayar di Midtrans (default dev http://localhost:5173; wajib di prod, bukan localhost)
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_PAYMENT_PROVIDER=midtrans
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_API_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_CORE_API_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_USE_CORE_API=true
# Foto produk: cloudinary (default) atau fake (tanpa Cloudinary; dilarang di prod). Kunci dari dashboard Cloudinary (paket gratis).
APP_IMAGES_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Menit sebelum order yang belum dibayar kedaluwarsa (default 60)
# APP_ORDER_EXPIRY_MINUTES=60

# Hanya untuk prod (Render/Neon); jangan diisi kosong di .env lokal:
# DATABASE_URL=jdbc:postgresql://HOST/DB?sslmode=require
# DATABASE_USER=
# DATABASE_PASSWORD=
# SPRING_PROFILES_ACTIVE=prod

# Email notifikasi pembeli (SMTP). Kosongkan MAIL_USERNAME/MAIL_PASSWORD atau set APP_MAIL_ENABLED=false = email dilewati (no-op).
# Nilai MAIL_FROM WAJIB diberi tanda kutip (ada < dan >, skrip bash gagal membacanya tanpa kutip).
# Gmail: MAIL_PASSWORD = App Password 16 karakter (bukan password akun), MAIL_FROM memakai alamat yang sama dengan MAIL_USERNAME.
APP_MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="TokoKu <alamat-anda@gmail.com>"

# Provider email: smtp (default) | brevo (API HTTPS; untuk host yang memblokir SMTP seperti Render free) | noop
# APP_MAIL_PROVIDER=smtp
# BREVO_API_KEY=            # rahasia; MAIL_FROM harus pengirim terverifikasi di Brevo
# Data demo produksi (opsional, aman): produk contoh + toko demo bila kosong; akun pembeli demo hanya bila password diisi
# APP_SEED_DEMO=false
# DEMO_USER_EMAIL=demo@tokoku.example
# DEMO_USER_PASSWORD=
