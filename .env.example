# Salin ke .env lalu isi sendiri. Jangan commit .env.
# Dipakai docker compose dan (lewat export) aplikasi lokal.
DB_PASSWORD=
# DB_PORT=5432   # port host Postgres; ganti jika bentrok (lalu sesuaikan DATABASE_URL)

# Wajib untuk prod/compose (min 32 karakter acak, mis. `openssl rand -base64 48`)
JWT_SECRET=
# Admin awal (dibuat sekali jika belum ada admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Origin frontend, dipisah koma (mis. http://localhost:5173)
APP_CORS_ALLOWED_ORIGINS=

# Hanya untuk prod (Render/Neon); jangan diisi kosong di .env lokal:
# DATABASE_URL=jdbc:postgresql://HOST/DB?sslmode=require
# DATABASE_USER=
# DATABASE_PASSWORD=
# SPRING_PROFILES_ACTIVE=prod
